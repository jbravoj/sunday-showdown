rules_version = '2';

// Clients only ever read. Every write to players, invitations, boards,
// payments, the ledger and the audit log goes through Cloud Functions (which
// use the Admin SDK and bypass these rules).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isApprovedPlayer() {
      return signedIn()
        && get(/databases/$(database)/documents/players/$(request.auth.uid)).data.status == "approved";
    }

    // A player can read their own record; the admin can read everyone's.
    match /players/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if false;
    }

    // Stored under a hash of the code; only the admin can list them.
    match /invitations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // The season's squares (who sits where): approved players and the admin.
    match /seasons/{season} {
      allow read: if isAdmin() || isApprovedPlayer();
      allow write: if false;

      // Weekly boards: players see them once published; drafts are admin-only.
      match /weeks/{week} {
        allow read: if isAdmin()
          || (isApprovedPlayer() && resource.data.status in ["open", "locked"]);
        allow write: if false;
      }
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else stays locked until a later phase opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
